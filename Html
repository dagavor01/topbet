<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TOPBET - Paris Sportifs Pro</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0f1215;color:#fff;font-family:Arial,sans-serif;display:flex;flex-direction:column;height:100vh}
.header{background:#1a1e23;padding:12px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #00FF88}
.logo{font-weight:900;font-size:24px;letter-spacing:2px}.logo span{color:#00FF88}
.btn{padding:8px 16px;border-radius:6px;border:none;font-weight:bold;cursor:pointer}
.btn-green{background:#00FF88;color:#000}.btn-dark{background:#2a2f36;color:#fff}
.main{display:flex;flex:1;overflow:hidden}
.matches{flex:1;padding:15px;overflow-y:auto}
.match-card{background:#1a1e23;border-radius:10px;padding:12px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;border-left:3px solid #00FF88}
.teams{font-weight:bold}.league{font-size:11px;color:#888}
.odds{display:flex;gap:6px}
.odd{background:#2a2f36;padding:8px 12px;border-radius:6px;cursor:pointer;font-weight:bold;border:1px solid transparent}
.odd:hover{border-color:#00FF88;background:#00FF8822}
.odd.active{background:#00FF88;color:#000}
.ticket{width:320px;background:#1a1e23;border-left:1px solid #333;padding:15px;display:flex;flex-direction:column}
.ticket h3{color:#00FF88;margin-bottom:10px}
#ticketList{flex:1;overflow-y:auto;font-size:13px}
.ticket-footer{border-top:1px solid #333;padding-top:10px;margin-top:10px}
.input-mise{width:100%;padding:10px;border-radius:6px;border:none;margin:8px 0;background:#0f1215;color:#fff;border:1px solid #333}
.gain{font-size:18px;font-weight:900;color:#00FF88}
.footer-ticker{background:#00FF88;color:#000;padding:6px;text-align:center;font-size:12px;font-weight:bold}
</style>
</head>
<body>

<div class="header">
<div class="logo">TOP<span>BET</span></div>
<div><button class="btn btn-dark">Connexion</button> <button class="btn btn-green">Inscription</button></div>
</div>

<div class="main">
<div class="matches">
<div style="color:#888;font-size:12px;margin-bottom:10px">🔴 LIVE • TOP MATCHS AUJOURD'HUI</div>

<div class="match-card">
<div><div class="league">Elite One - Cameroun • 19:00</div><div class="teams">Canon Yaoundé vs Coton Sport</div></div>
<div class="odds"><div class="odd" onclick="addBet('Canon Yaoundé',2.15)">1 - 2.15</div><div class="odd" onclick="addBet('Nul',3.10)">X - 3.10</div><div class="odd" onclick="addBet('Coton Sport',2.90)">2 - 2.90</div></div>
</div>

<div class="match-card">
<div><div class="league">Premier League • 21:00</div><div class="teams">Man City vs Arsenal</div></div>
<div class="odds"><div class="odd" onclick="addBet('Man City',1.85)">1 - 1.85</div><div class="odd" onclick="addBet('Nul',3.50)">X - 3.50</div><div class="odd" onclick="addBet('Arsenal',4.20)">2 - 4.20</div></div>
</div>

<div class="match-card">
<div><div class="league">La Liga • 21:00</div><div class="teams">Real Madrid vs Barcelona</div></div>
<div class="odds"><div class="odd" onclick="addBet('Real Madrid',2.10)">1 - 2.10</div><div class="odd" onclick="addBet('Nul',3.30)">X - 3.30</div><div class="odd" onclick="addBet('Barcelona',3.10)">2 - 3.10</div></div>
</div>

</div>

<div class="ticket">
<h3>🎟️ Mon Ticket <span id="count">(0)</span></h3>
<div id="ticketList" style="color:#888">Clique sur une cote pour parier</div>
<div class="ticket-footer">
<input id="mise" class="input-mise" type="number" placeholder="Mise FCFA - ex: 1000" oninput="calcGain()">
<div>Gain potentiel: <span class="gain" id="gain">0 FCFA</span></div>
<button class="btn btn-green" style="width:100%;margin-top:10px;padding:12px" onclick="parier()">PARER MAINTENANT</button>
<p style="font-size:10px;color:#888;margin-top:8px;text-align:center">Paiement: MoMo • OM • USDT<br>Support: <a href="https://wa.me/237655166310" style="color:#00FF88">+237 655 16 63 10</a></p>
</div>
</div>
</div>

<div class="footer-ticker">TOPBET - 18+ Jouez responsable • Licence Curaçao en cours • Dépôt minimum 500 FCFA</div>

<script>
let selections=[];
let totalCote=1;
function addBet(team,cote){
 selections.push({team,cote});
 totalCote*=cote;
 document.getElementById('count').innerText='('+selections.length+')';
 let html=selections.map(s=>`• ${s.team} @ ${s.cote}<br>`).join('');
 html+=`<br>Cote totale: <b>${totalCote.toFixed(2)}</b>`;
 document.getElementById('ticketList').innerHTML=html;
 calcGain();
}
function calcGain(){
 let mise=document.getElementById('mise').value||0;
 document.getElementById('gain').innerText=(mise*totalCote).toFixed(0)+' FCFA';
}
function parier(){
 let mise=document.getElementById('mise').value;
 if(selections.length==0){alert('Choisis une cote');return;}
 if(!mise){alert('Mets ta mise');return;}
 let msg=`Salut TOPBET, je veux parier: ${selections.map(s=>s.team+' @'+s.cote).join(' + ')} | Mise: ${mise} FCFA | Gain: ${document.getElementById('gain').innerText}`;
 window.open('https://wa.me/237655166310?text='+encodeURIComponent(msg),'_blank');
}
</script>
</body>
</html>
